# 이 파일을 복사해서 .env로 저장한 뒤 실제 값을 채우세요.
#   cp .env.example .env
# .env는 .gitignore에 포함되어 있어 git에 올라가지 않습니다.
#
# 이 값들이 비어있거나 파일이 없으면, 스크립트는 자동으로 각 카테고리의
# sample_data/ 로컬 파일을 사용합니다 (즉 설정 안 해도 실행은 됩니다).
#
# 회사/계정이 바뀌면 아래 값만 새로 채우면 되고 코드는 건드릴 필요 없습니다.

# 구글 시트 주소의 /d/ 와 /edit 사이에 있는 긴 문자열
GOOGLE_SHEET_ID=

# 읽어올 탭(워크시트) 이름
GOOGLE_WORKSHEET_NAME=Sheet1

# Google Cloud Console에서 발급받은 서비스 계정 JSON 키 파일 경로
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/service_account.json
